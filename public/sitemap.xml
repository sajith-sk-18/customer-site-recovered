<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static sitemap for the main storefront pages. Replace https://your-domain.com with your
  production domain. Product detail pages (/products/{id}) are best added by generating this
  file from the API at build/deploy time.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>https://your-domain.com/</loc><changefreq>daily</changefreq><priority>1.0</priority></url>
  <url><loc>https://your-domain.com/products</loc><changefreq>daily</changefreq><priority>0.9</priority></url>
  <url><loc>https://your-domain.com/upcoming</loc><changefreq>weekly</changefreq><priority>0.7</priority></url>
  <url><loc>https://your-domain.com/about</loc><changefreq>monthly</changefreq><priority>0.5</priority></url>
  <url><loc>https://your-domain.com/contact</loc><changefreq>monthly</changefreq><priority>0.6</priority></url>
</urlset>
