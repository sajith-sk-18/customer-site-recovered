# Production build for https://flurotech.in (Hostinger, single origin).
# Vite inlines these at BUILD time; `vite build` loads .env.production automatically.
# The API is same-origin at /api, so the browser makes no cross-origin request and
# CORS never applies to the live site.
VITE_API_URL=https://flurotech.in/api
VITE_SITE_URL=https://flurotech.in
VITE_ADMIN_WHATSAPP=919677409009
